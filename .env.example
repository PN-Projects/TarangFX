# HF_TOKEN = hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Telegram Bot Configuration
API_ID=12345678
API_HASH="your_api_hash_here"
BOT_TOKEN="your_bot_token_here"
DATABASE_URL="postgresql://user:password@host:5432/dbname"
SUDO_USERS=123456789,987654321

# File Processing Limits
# Note: Standard Telegram Bot API limits downloads to 20 MB
# For files >20 MB, you need a Local Bot API Server: https://core.telegram.org/bots/api#using-a-local-bot-api-server
MAX_FILE_SIZE_GB=5
FREE_TIER_MAX_DURATION_MINUTES=30
PREMIUM_MAX_SAMPLE_RATE=96000
REDIS_URL=

# Upstash Redis REST Credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

REDIS_POOL_SIZE=50
CACHE_TTL=300

# Session Configuration
SESSION_TIMEOUT_MINUTES=5

# Temporary File Storage
TEMP_DIR=/tmp/tarangfx

# Logging
LOG_LEVEL=INFO

# Task Queue Configuration
MAX_CONCURRENT_WORKERS=20


